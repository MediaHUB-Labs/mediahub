# MediaHUB Environment File

# PORT CONFIGURATION
APP_PORT=9123
UI_PORT=9124

# DATABASE (SQLite)
DB_PATH=mediahub.db

# ENVIRONMENT TYPE
# Set "release" for production & "debug" for development
GIN_MODE=debug

# Debugger - Set false for production
LOGGER=true

# JWT SETTINGS
JWT_SECRET=change-this-to-a-strong-secret-key
JWT_EXPIRY_MINUTES=1440

# UPLOAD SETTINGS
# Absolute path for file storage. 
# Leave empty to use ./uploads relative to executable.
UPLOAD_PATH="./uploads"

# TRANSCODING SETTINGS
# Maximum concurrent transcode jobs (default: 1, recommended for CPU-only systems)
MAX_TRANSCODE_JOBS=1
# FFmpeg preset: ultrafast, superfast, veryfast, faster, fast, medium
# Use "veryfast" or "ultrafast" for low-spec systems
FFMPEG_PRESET=veryfast
# CRF quality (0-51, lower = better quality, 23 is default)
FFMPEG_CRF=23
